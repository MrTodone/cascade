{
  "name": "@mrtodone/cascade",
  "version": "0.4.0",
  "description": "Local AI model router + VLESS/sing-box tunnel facade with an OpenAI-compatible API. Installs prebuilt, runs on Node >= 22 with zero build step.",
  "type": "module",
  "bin": {
    "cascade": "./bin/cascade.js"
  },
  "files": [
    "bin/",
    "dist/",
    "configs/",
    "scripts/npm-smoke.mjs",
    "cascade-router/catalog.json",
    "metadata.json",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "scripts": {
    "dev": "tsx server/dev-entry.ts",
    "lint": "tsc --noEmit",
    "build": "vite build && esbuild server/exe-entry.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:npm": "node scripts/build-npm.mjs",
    "start": "node dist/server.cjs",
    "pack": "npm run build:npm && npm pack",
    "dist:windows": "node scripts/dist-windows.mjs",
    "dist:linux": "node scripts/dist-linux.mjs"
  },
  "dependencies": {
    "@google/genai": "2.22.0",
    "dotenv": "17.4.2",
    "express": "4.22.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "4.17.25",
    "@types/node": "22.20.2",
    "autoprefixer": "10.6.1",
    "esbuild": "0.25.12",
    "lucide-react": "0.546.0",
    "motion": "12.43.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.8.3",
    "vite": "6.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrTodone/cascade.git"
  },
  "bugs": {
    "url": "https://github.com/MrTodone/cascade/issues"
  },
  "homepage": "https://github.com/MrTodone/cascade#readme",
  "keywords": [
    "ai",
    "router",
    "llm",
    "openai",
    "proxy",
    "sing-box",
    "vless",
    "local"
  ],
  "author": "MrTodone",
  "license": "MIT"
}
