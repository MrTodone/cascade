# Cascade — example environment file. Copy to .env and fill in real values.
# Never commit the resulting .env (it is gitignored). All values here are
# placeholders; a provider without a key is simply inactive (boolean hasApiKey).

# ---- Facade (server.ts, port 3000) ----
# Base URL the facade advertises for self-referential links.
APP_URL="http://127.0.0.1:3000"
# Provider keys used directly by the facade (sandbox / code generation), optional.
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""

# ---- Router engine (cascade-router, spawned by the facade on :19080) ----
# Set automatically by server/routerService.ts; uncomment to override in dev.
# CASCADE_ROUTER_PORT="19080"
# CASCADE_ROUTER_CONFIG="/absolute/path/to/cascade-run/router/config.json"
# CASCADE_ROUTER_STATE_DIR="/absolute/path/to/state"
# CASCADE_ROUTER_CATALOG="/absolute/path/to/cascade-router/catalog.json"

# ---- Frontend (Vite dev middleware) ----
# NODE_ENV="production"   # production disables the in-process Vite dev middleware
# DISABLE_HMR="1"         # disable Hot Module Replacement (used by vite.config.ts)

# ---- Testing / tooling (all optional; defaults are code-side) ----
# MOCK_LOG="/path/to/mock.log"        # mock-suite reads router output from this path
# PROBE_WORK="/tmp/cascade-probe"     # working dir for probe scripts (parallel sing-box)
# SGBOX="/opt/homebrew/bin/sing-box"  # sing-box binary used by probe scripts
# ROUTER_BASE="http://127.0.0.1:19080"  # parity-suite target (live router)
# ROUTER_LABEL=""                     # parity-suite label to test (default: the base URL)
# ROUTER_PINS="cascade:@mistral/codestral-latest"  # pinned-model ids for parity (comma-separated)
# PARITY_JSON="/path/to/parity.json"  # parity-suite: write results to this file
# PARITY_TIMEOUT_MS="30000"           # per-request timeout for parity checks
# PARITY_WRITE="1"                   # parity-suite: write expectations instead of assert